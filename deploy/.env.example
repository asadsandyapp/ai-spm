# Copy to deploy/.env (used by docker compose). Do not commit real secrets.
#   cp deploy/.env.example deploy/.env
#
# Use TEST mode keys only for local/dev (sk_test_… / price_… from Test mode).
# Never put sk_live_ keys in example files or git.

STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_PASTE_YOUR_TEST_SECRET_KEY_HERE

# Stripe Dashboard (Test mode) → Products → Price → copy Price ID (price_…)
# Checkout uses lookup_key (starter_monthly / professional_monthly) when set on
# the Price in Stripe; otherwise falls back to these STRIPE_PRICE_* IDs.
STRIPE_PRICE_STARTER=price_PASTE_STARTER_PRICE_ID
STRIPE_PRICE_PROFESSIONAL=price_PASTE_PROFESSIONAL_PRICE_ID

# Optional until you forward webhooks locally
STRIPE_WEBHOOK_SECRET=
