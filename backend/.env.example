# AI-SPM SaaS Multi-Tenant Platform

DATABASE_URL=postgresql+asyncpg://aispm:aispm@localhost:5432/aispm
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-use-vault-in-production
PLATFORM_JWT_SECRET_KEY=change-me-platform-secret

APP_ENV=development
DEBUG=true
APP_BASE_URL=http://localhost:5173
# Public Kong/gateway URL for agent enrollment packages (local or cloud).
AISPM_PUBLIC_GATEWAY_URL=http://localhost:8090
# Prebuilt Linux installer assets for Admin → Download Agent sealed .run.
AISPM_INSTALLER_LINUX_DIR=/opt/ai-spm/installer-linux
# Optional HMAC key material stamped into sealed installer metadata (falls back to JWT_SECRET_KEY).
AISPM_INSTALLER_SIGNING_KEY=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
